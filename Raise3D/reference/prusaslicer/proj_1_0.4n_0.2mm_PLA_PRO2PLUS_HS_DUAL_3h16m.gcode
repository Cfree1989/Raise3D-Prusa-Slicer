; post_process = "C:\\Python313\\python.exe C:\\Repos\\Raise3D-Prusa-Slicer\\scripts\\ensure_m99123_first.py\nC:\\Python313\\python.exe C:\\Repos\\Raise3D-Prusa-Slicer\\scripts\\validate_gcode.py"
; prefer_clockwise_movements = 0
; print_settings_id = 0.20mm STRUCTURAL @Raise3D Pro2 Plus HS
; printer_model = PRO2PLUS_HS_DUAL
; printer_notes = Don't remove the following keywords! These keywords are used in the compatible printer condition of the print and filament profiles.\nPRINTER_VENDOR_RAISE3D\nPRINTER_MODEL_PRO2PLUS_HS\nPRINTER_VARIANT_DUAL\nEXPERIMENTAL\nNot production-ready. Hyper Speed / Klipper Pro2 Plus dual electronic-lift heads.\nLeft-only from LeftonlyExtruder.gcode. Right-only (T1 home + same X20 Y0 wipe) from RightonlyExtruder.gcode. Dual start, standby tool-change, and dual end from MulticolorRaise3d.gcode. Single-tool end from the matching ideaMaker file (no unused-tool M104/M221). XY nozzle offset is firmware (factory ~25 mm X) — slicer offset is 0 so it is not applied twice. PrusaSlicer 2.9.6 has no per-tool printable area; the bed texture marks the leftmost 25 mm as T1 keep-out. Default wipe tower is X50 Y140 (past that band; drag on the plater). Stage 6-7 physical tests still required.
; printer_settings_id = Raise3D Pro2 Plus Hyper Speed 0.4 Dual
; printer_technology = FFF
; printer_variant = 0.4
; printer_vendor = 
; profile_vendor = Raise3D (experimental)
; profile_version = 0.5.14
; raft_contact_distance = 0.15
; raft_expansion = 1.5
; raft_first_layer_density = 90%
; raft_first_layer_expansion = 3
; raft_layers = 0
; remaining_times = 0
; resolution = 0
; retract_before_travel = 1,1
; retract_before_wipe = 0%,0%
; retract_layer_change = 1,1
; retract_length = 1.5,1.5
; retract_length_toolchange = 11,11
; retract_lift = 0,0
; retract_lift_above = 0,0
; retract_lift_below = 0,0
; retract_restart_extra = 0,0
; retract_restart_extra_toolchange = 0,0
; retract_speed = 40,40
; scarf_seam_entire_loop = 0
; scarf_seam_length = 20
; scarf_seam_max_segment_length = 1
; scarf_seam_on_inner_perimeters = 0
; scarf_seam_only_on_smooth = 1
; scarf_seam_placement = nowhere
; scarf_seam_start_height = 0%
; seam_gap_distance = 15%
; seam_position = aligned
; silent_mode = 0
; single_extruder_multi_material = 0
; single_extruder_multi_material_priming = 0
; skirt_distance = 6
; skirt_height = 1
; skirts = 0
; slice_closing_radius = 0.049
; slicing_mode = regular
; slowdown_below_layer_time = 10,10
; small_perimeter_speed = 45
; solid_infill_acceleration = 2000
; solid_infill_below_area = 0
; solid_infill_every_layers = 0
; solid_infill_extruder = 1
; solid_infill_extrusion_width = 0.45
; solid_infill_speed = 140
; spiral_vase = 0
; staggered_inner_seams = 0
; standby_temperature_delta = -5
; start_filament_gcode = ;
; start_gcode = M99123 \n; EXPERIMENTAL PrusaSlicer dual profile - not production-ready\n; Dual start/tool-change from MulticolorRaise3d.gcode; left-only from LeftonlyExtruder.gcode; right-only from RightonlyExtruder.gcode\n;Dimension: 305.000 305.000 605.000 0.400 0.400\n;Plate Shape: 0\n;Origin Center: 0\n;Extruder Offset #1: 0.000 0.000\n;Printer Type: RAISE3D Pro2 Plus - Hyper Speed\n;Firmware: Klipper\n;Filament Diameter #1: {filament_diameter[0]}\n;Filament Diameter #2: {filament_diameter[1]}\n;Filament Compensation #1: {extrusion_multiplier[0]*100}\n;Filament Compensation #2: {extrusion_multiplier[1]*100}\n;Filament Density #1: {filament_density[0]*1000}\n;Filament Density #2: {filament_density[1]*1000}\n;Filament Type #1: {filament_type[0]}\n;Filament Type #2: {filament_type[1]}\n;Filament Name #1: {"[Raise3D] PLA"}\n;Filament Name #2: {"[Raise3D] PLA"}\n;Filament #1: PLA 1.75mm\n;Filament #2: PLA 1.75mm\n{if is_extruder_used[0]}M221 T0 S{extrusion_multiplier[0]*100}\nM104 T0 S{first_layer_temperature[0]}\n{endif}\n{if is_extruder_used[1]}M221 T1 S{extrusion_multiplier[1]*100}\nM104 T1 S{first_layer_temperature[1]}\n{endif}\nM140 S{first_layer_bed_temperature[0]}\n{if is_extruder_used[0]}M109 T0 S{first_layer_temperature[0]}\n{endif}\n{if is_extruder_used[1]}M109 T1 S{first_layer_temperature[1]}\n{endif}\n{if is_extruder_used[0]}T0\n{else}T1\n{endif}\nM190 S{first_layer_bed_temperature[0]}\nG21\nG90\nM83\nM107\nG28 X0 Y0\nG28 Z0\nG1 Z15.0 F300\n{if is_extruder_used[0] && is_extruder_used[1] && initial_extruder == 0}\nT1\nG92 E0\nG1 F200 E10\nG92 E0\nG1 F200 E-11.00\nT0\nG92 E0\nG1 F200 E10\nG92 E0\n{elsif is_extruder_used[0] && is_extruder_used[1]}\nT0\nG92 E0\nG1 F200 E10\nG92 E0\nG1 F200 E-11.00\nT1\nG92 E0\nG1 F200 E10\nG92 E0\n{elsif is_extruder_used[0]}\nT0\nG92 E0\nG1 F140 E29\nG1 X20 Y0 F140 E1\nG92 E0\n{else}\nT1\nG92 E0\nG1 F140 E29\nG1 X20 Y0 F140 E1\nG92 E0\n{endif}\n{if initial_extruder == 0}T0\n{else}T1\n{endif}\nG1 F9000.0\nM117 Printing...\nM1001\nSET_VELOCITY_LIMIT ACCEL=5000.00\nSET_VELOCITY_LIMIT SQUARE_CORNER_VELOCITY=10.00\n{if is_extruder_used[0] && is_extruder_used[1] && initial_extruder == 0}\nM104 T1 S180\n{elsif is_extruder_used[0] && is_extruder_used[1]}\nM104 T0 S180\n{endif}
