; start_filament_gcode = ;
; start_gcode = M99123 \n; EXPERIMENTAL PrusaSlicer dual profile - not production-ready\n; Dual start/tool-change from MulticolorRaise3d.gcode; left-only from LeftonlyExtruder.gcode; right-only from RightonlyExtruder.gcode\n;Dimension: 305.000 305.000 605.000 0.400 0.400\n;Plate Shape: 0\n;Origin Center: 0\n;Extruder Offset #1: 0.000 0.000\n;Printer Type: RAISE3D Pro2 Plus - Hyper Speed\n;Firmware: Klipper\n;Filament Diameter #1: {filament_diameter[0]}\n;Filament Diameter #2: {filament_diameter[1]}\n;Filament Compensation #1: {extrusion_multiplier[0]*100}\n;Filament Compensation #2: {extrusion_multiplier[1]*100}\n;Filament Density #1: {filament_density[0]*1000}\n;Filament Density #2: {filament_density[1]*1000}\n;Filament Type #1: {filament_type[0]}\n;Filament Type #2: {filament_type[1]}\n;Filament Name #1: {"[Raise3D] "}{filament_type[0]}\n;Filament Name #2: {"[Raise3D] "}{filament_type[1]}\n;Filament #1: {filament_type[0]} 1.75mm\n;Filament #2: {filament_type[1]} 1.75mm\n{if is_extruder_used[0]}M221 T0 S{extrusion_multiplier[0]*100}\nM104 T0 S{first_layer_temperature[0]}\n{endif}\n{if is_extruder_used[1]}M221 T1 S{extrusion_multiplier[1]*100}\nM104 T1 S{first_layer_temperature[1]}\n{endif}\nM140 S{first_layer_bed_temperature[0]}\n{if is_extruder_used[0]}M109 T0 S{first_layer_temperature[0]}\n{endif}\n{if is_extruder_used[1]}M109 T1 S{first_layer_temperature[1]}\n{endif}\n{if is_extruder_used[0]}T0\n{else}T1\n{endif}\nM190 S{first_layer_bed_temperature[0]}\nG21\nG90\nM83\nM107\nG28 X0 Y0\nG28 Z0\nG1 Z15.0 F300\n{if is_extruder_used[0] && is_extruder_used[1] && initial_extruder == 0}\nT1\nG92 E0\nG1 F200 E10\nG92 E0\nG1 F200 E-11.00\nT0\nG92 E0\nG1 F200 E10\nG92 E0\n{elsif is_extruder_used[0] && is_extruder_used[1]}\nT0\nG92 E0\nG1 F200 E10\nG92 E0\nG1 F200 E-11.00\nT1\nG92 E0\nG1 F200 E10\nG92 E0\n{elsif is_extruder_used[0]}\nT0\nG92 E0\nG1 F140 E29\nG1 X80 Y0 F140 E1\nG92 E0\n{else}\nT1\nG92 E0\nG1 F140 E29\nG1 X80 Y0 F140 E1\nG92 E0\n{endif}\n{if initial_extruder == 0}T0\n{else}T1\n{endif}\nG1 X80 Y0 F9000\nG1 F9000.0\nM117 Printing...\nM1001\nSET_VELOCITY_LIMIT ACCEL=5000.00\nSET_VELOCITY_LIMIT SQUARE_CORNER_VELOCITY=10.00\n{if is_extruder_used[0] && is_extruder_used[1] && initial_extruder == 0}\nM104 T1 S180\n{elsif is_extruder_used[0] && is_extruder_used[1]}\nM104 T0 S180\n{endif}
